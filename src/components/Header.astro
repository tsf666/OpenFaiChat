    <a href="https://faichat.netlify.app/" class="gpt-subtitle text-2xl font-extrabold mr-2 text-[var(--c-fg) ] opacity-90"
    >
      Chat
    </a>
    <span class="opacity-50">refactor from</span>
    <a href="https://github.com/babaohuang/GeminiProChat"
      class="opacity-50"
    >
      &nbsp;GeminiProChat
    </a>
  </div>
  

  <p class="head-desc">
    <span>Based on</span>
 
    <a href="https://gprochat.com/"
      class="transition-colors"
    >
      gprochat.com
    </a>

    <span>and</span>

    <a href="https://blog.geminiprochat.com/posts/what-is-gemini"
      class="transition-colors"
